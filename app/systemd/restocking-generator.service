[Unit]
Description=Restocking File Generator (oneshot)
After=network.target

[Service]
Type=oneshot
User=appuser
Group=appuser
WorkingDirectory=/opt/app/app
EnvironmentFile=/opt/app/.env
ExecStart=/opt/app/.venv/bin/python /opt/app/app/restocking_file_generator.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=restocking-generator

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/app /var/restocking

[Install]
WantedBy=multi-user.target
