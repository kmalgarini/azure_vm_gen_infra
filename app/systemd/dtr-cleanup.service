[Unit]
Description=Delete DTR artefact files older than retention window
After=network.target

[Service]
Type=oneshot
User=appuser
Group=appuser
EnvironmentFile=/opt/app/.env
ExecStart=/bin/bash -c 'find "$RESTOCKING_INBOUND_DIR" -maxdepth 1 -type f -mtime +$RESTOCKING_ARTEFACT_RETENTION_DAYS -delete && echo "DTR cleanup complete"'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dtr-cleanup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/restocking

[Install]
WantedBy=multi-user.target
