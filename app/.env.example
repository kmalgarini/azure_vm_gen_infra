# Application runtime environment
APP_ENV=dev
APP_PORT=8000

# Restocking file generator
RESTOCKING_INBOUND_DIR=/var/restocking/inbound
RESTOCKING_STATE_FILE=/opt/app/generator_state.json
RESTOCKING_DTRS_PER_BATCH=3
RESTOCKING_FAIL_RATE=0.05

# Add your own environment-specific secrets below.
# Do NOT commit values — this file is a template only.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# SECRET_KEY=change-me
